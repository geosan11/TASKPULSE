# ========================================================
# TaskPulse Production Environment Variables (Vercel)
# ========================================================

# --------------------------------------------------------
# 1. PAYSTACK CONFIGURATION
# --------------------------------------------------------
# Public key used by frontend for checkout and card inputs
VITE_PAYSTACK_PUBLIC_KEY="your_paystack_public_key_here"

# Secret key used in serverless backend (/api/*) for verification & transfers
# Add this in Vercel Project Settings -> Environment Variables
PAYSTACK_SECRET_KEY="your_paystack_secret_key_here"


# --------------------------------------------------------
# 2. SUPABASE DATABASE CONFIGURATION
# --------------------------------------------------------
# Project URL found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Public anon key (Safe for browser and frontend use)
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# REQUIRED: Service Role secret key, used ONLY by /api/* serverless functions
# (campaign funding, payment settlement, withdrawals, bank linking).
# Never prefix it with VITE_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"


# --------------------------------------------------------
# 3. APPLICATION DOMAIN
# --------------------------------------------------------
APP_URL="https://taskpulse.website"
