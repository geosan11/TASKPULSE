# ==========================================
# TaskPulse Environment Configuration (Vercel)
# ==========================================

# 1. Frontend Paystack Key (Public)
# Used in the browser for checkout popup & card tokenize
VITE_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 2. Backend Paystack Secret Key (Private)
# Used inside Vercel Serverless Functions (/api/*)
# NEVER EXPOSE IN CLIENT FILES OR COMMIT WITH REAL VALUE
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Application Base URL
APP_URL="https://your-taskpulse-domain.vercel.app"
